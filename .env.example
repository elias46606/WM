# ============================================================
# JARVIS — Environment-Konfiguration
# Kopiere diese Datei zu ".env.local" und trage deine echten
# Keys ein. ".env.local" wird nie eingecheckt (siehe .gitignore).
# ============================================================

# --- Notion ---------------------------------------------------
# Internal Integration Token: https://www.notion.so/my-integrations
# WICHTIG: Die Integration muss in allen 3 Datenbanken über
# "..." -> "Connections" -> "Jarvis" manuell freigegeben werden.
NOTION_TOKEN=secret_xxx
NOTION_DB_SCHULE=
NOTION_DB_PROJEKTE=
NOTION_DB_DEPOT=

# --- Abitur-Countdown -------------------------------------------
# Datum der ersten Abiturprüfung (YYYY-MM-DD). Falls leer, versucht
# Jarvis das früheste passende Datum aus der Schule-DB zu ziehen.
ABITUR_START_DATE=

# --- ElevenLabs (Sprachsteuerung) ------------------------------
ELEVENLABS_API_KEY=
# Stimme für die Sprachausgabe, z.B. eine Voice-ID aus deinem
# ElevenLabs-Account (Standard: "Rachel")
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- Gmail -------------------------------------------------------
# OAuth2-Client aus der Google Cloud Console (Desktop- oder Web-App)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_REDIRECT_URI=http://localhost:3000/api/email/oauth/callback

# --- Daily Briefing ------------------------------------------------
# Geheimer Token, den dein Cowork Scheduled Task beim POST an
# /api/briefing mitschicken muss (Header: x-briefing-token)
BRIEFING_INGEST_TOKEN=change-me

# --- Sub-Agents / Browser-MCP (Grundgerüst, optional) ------------
# Wird erst in einer späteren Ausbaustufe benötigt.
MCP_BROWSER_ENDPOINT=

# --- Gemini (echte Konversation im Sprach-Assistenten, kostenlos) --
# Optional: ohne diesen Key beantwortet Jarvis Sprachanfragen nur
# regelbasiert (Countdown/Termine/Projekte/Depot). Mit Key übernimmt
# Gemini alle Anfragen und bekommt die Live-Dashboard-Daten als
# Kontext mitgegeben. Kostenloser Key (kein Zahlungsmittel nötig)
# aus https://aistudio.google.com/apikey
GEMINI_API_KEY=
